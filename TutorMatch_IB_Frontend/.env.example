# ---------------------------------------------------------------------------
# TutorMatch IB - environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored and must NEVER be committed.
#
# NEVER prefix a secret with NEXT_PUBLIC_. Anything with that prefix is
# inlined into the browser bundle.
# ---------------------------------------------------------------------------

# --- Supabase (Phase 3) -----------------------------------------------------
# Project settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used for privileged server work such as webhooks and admin
# operations. Never import this from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin bootstrap --------------------------------------------------------
# Comma-separated allow-list. An account whose email is listed here is promoted
# to the `admin` role on sign-in (the very first admin cannot be made through
# the normal signup flow). Server-only; never expose it to the browser.
# Example: ADMIN_EMAILS=you@example.com,teammate@example.com
ADMIN_EMAILS=

# --- OpenAI (Phase 8) -------------------------------------------------------
# Server-only. All OpenAI calls happen in route handlers / server actions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- App --------------------------------------------------------------------
# Canonical deployment URL, used for metadata and absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
